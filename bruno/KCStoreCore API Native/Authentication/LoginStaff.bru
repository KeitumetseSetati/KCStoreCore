
meta {
  name: LoginStaff
  type: http
  seq: 4
}

post {
  url: {{localUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "newstaff@example.com",
    "password": "{{testStaffPassword}}"
  }
}

script:post-response {
  if (res.status === 200) {
    const response = res.getBody();

    if (response && response.accessToken) {
      bru.setVar("staffToken", response.accessToken);
      console.log("Staff token captured successfully.");
    } else {
      console.log("Staff login succeeded, but no access token was found.");
    }
  } else {
    console.log("Staff login failed. No token captured.");
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
