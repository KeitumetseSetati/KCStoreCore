meta {
  name: CreateSupplier
  type: http
  seq: 2
}

post {
  url: {{localUrl}}/api/suppliers
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "name": "TechSource Distributors",
      "contactPerson": "John Smith",
      "email": "john@techsource.example",
      "phoneNumber": "0123456789",
      "address": "100 Industrial Road, Pretoria"
    }
}

vars:pre-request {
  localUrl: https://localhost:7280
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
