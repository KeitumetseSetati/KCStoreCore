
meta {
  name: GetDashboardAsManager
  type: http
  seq: 6
}

get {
  url: {{localUrl}}/api/reports/dashboard
  body: none
  auth: bearer
}

auth:bearer {
  token: {{managerToken}}
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
