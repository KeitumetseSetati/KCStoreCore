meta {
  name: GetReceiptsByPurchaseOrder
  type: http
  seq: 4
}

get {
  url: {{localUrl}}/api/stock-receipts/purchase-orders/{{purchaseOrderId}}
  body: none
  auth: inherit
}

vars:pre-request {
  localUrl: https://localhost:7280
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
