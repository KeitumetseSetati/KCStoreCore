meta {
  name: UpdateProduct
  type: http
  seq: 5
}

put {
  url: {{localUrl}}/api/products/{{productId}}
  body: json
  auth: inherit
}

body:json {
  {
    "sku": "ELEC-001",
    "name": "Wireless Mouse Pro",
    "description": "Updated wireless optical mouse with USB receiver",
    "categoryId": "3c1bae6b-4e8f-40fb-8ca0-24961d475914",
    "unitPrice": 299.99,
    "costPrice": 175.00,
    "isActive": true
  }
}

vars:pre-request {
  localUrl: https://localhost:7280
  productId: f719a37e-67be-463e-9b8c-8a264d6edea4
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
